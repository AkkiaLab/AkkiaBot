{
  "uid": "akkiabot-overview",
  "title": "AkkiaBot",
  "description": "AkkiaBot 总览、入群验证、反垃圾、群管理与日志（docs/observability.md）。",
  "tags": ["akkiabot"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "prometheus",
        "label": "Prometheus",
        "query": "prometheus",
        "hide": 0
      },
      {
        "type": "datasource",
        "name": "loki",
        "label": "Loki",
        "query": "loki",
        "hide": 0
      },
      {
        "type": "query",
        "name": "env",
        "label": "环境",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(up{job=\"akkiabot\"}, env)",
          "refId": "env"
        },
        "definition": "label_values(up{job=\"akkiabot\"}, env)",
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "type": "custom",
        "name": "service",
        "label": "服务",
        "query": "app,migrate,postgres,redis,cloudflared,alloy",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": ["app"],
          "value": ["app"]
        },
        "hide": 0
      },
      {
        "type": "custom",
        "name": "level",
        "label": "级别",
        "query": "debug,info,warning,error,critical",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": ["All"],
          "value": ["$__all"]
        },
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "chat_id",
        "label": "chat_id",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "user_id",
        "label": "user_id",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "trace_id",
        "label": "trace_id",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "challenge_id",
        "label": "challenge_id",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "搜索（正则）",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "总览",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Update 速率（按类型）",
      "description": "akkiabot_updates_total：每秒收到的 Telegram update。",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (type) (rate(akkiabot_updates_total{env=\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Handler 耗时 P50 / P95",
      "description": "akkiabot_handler_duration_seconds，全部 handler 合计。",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(akkiabot_handler_duration_seconds_bucket{env=\"$env\"}[$__rate_interval])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(akkiabot_handler_duration_seconds_bucket{env=\"$env\"}[$__rate_interval])))",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Handler 错误率",
      "description": "handler_errors_total / handler 调用次数；没有错误时为 0。告警阈值 5%。",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "(sum(rate(akkiabot_handler_errors_total{env=\"$env\"}[$__rate_interval])) or vector(0)) / sum(rate(akkiabot_handler_duration_seconds_count{env=\"$env\"}[$__rate_interval]))",
          "legendFormat": "错误率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "stat",
      "title": "/readyz",
      "description": "Alloy blackbox 探测 /readyz：1 = 就绪，0 = 数据库或缓存不可用、app 无响应。",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "min(probe_success{env=\"$env\",job=\"akkiabot-readyz\"})",
          "legendFormat": "readyz",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "失败",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "距上次成功轮询",
      "description": "now - telegram_poll_last_success_timestamp_seconds（polling 模式）；超过 120 秒并持续 1 分钟告警（橙色 60 秒、红色 120 秒）。",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "time() - max(akkiabot_telegram_poll_last_success_timestamp_seconds{env=\"$env\"})",
          "legendFormat": "距上次成功轮询",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "timeseries",
      "title": "Handler 耗时 P95（按 handler）",
      "description": "每个 handler 的 P95。",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(akkiabot_handler_duration_seconds_bucket{env=\"$env\"}[$__rate_interval])))",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Telegram API 失败（按方法）",
      "description": "业务代码调用 Bot API 失败（含限流）；没有失败时为 0。",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (method) (increase(akkiabot_telegram_api_errors_total{env=\"$env\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "入群验证",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "入群验证漏斗（所选时间范围）",
      "description": "发起 = 新成员被禁言并收到验证；通过 / 超时为最终结果；失败为被拒绝的验证尝试（一次验证可能失败多次）。",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(akkiabot_captcha_started_total{env=\"$env\"}[$__range])) or vector(0)",
          "legendFormat": "发起",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(akkiabot_captcha_total{env=\"$env\",result=\"passed\"}[$__range])) or vector(0)",
          "legendFormat": "通过",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(akkiabot_captcha_total{env=\"$env\",result=\"timeout\"}[$__range])) or vector(0)",
          "legendFormat": "超时",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(akkiabot_captcha_total{env=\"$env\",result=\"failed\"}[$__range])) or vector(0)",
          "legendFormat": "失败",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "type": "timeseries",
      "title": "入群验证趋势",
      "description": "每个时间桶内的发起与结果数。",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(akkiabot_captcha_started_total{env=\"$env\"}[$__rate_interval]))",
          "legendFormat": "发起"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (result) (increase(akkiabot_captcha_total{env=\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "通过耗时 P50 / P95",
      "description": "captcha_duration_seconds：从入群到通过。",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(akkiabot_captcha_duration_seconds_bucket{env=\"$env\"}[$__rate_interval])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(akkiabot_captcha_duration_seconds_bucket{env=\"$env\"}[$__rate_interval])))",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "验证页面漏斗（所选时间范围）",
      "description": "Mini App 验证页面上报的事件：打开 = 页面显示了人机验证组件；求解 = Turnstile 完成；提交 = 发出验证请求；通过 = 页面收到验证成功。按次数统计，同一成员重新打开页面会再计一次。上报尽力而为，可能略少于服务端计数。",
      "id": 25,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(akkiabot_captcha_client_events_total{env=\"$env\",event=\"page_loaded\"}[$__range])) or vector(0)",
          "legendFormat": "打开",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(akkiabot_captcha_client_events_total{env=\"$env\",event=\"turnstile_solved\"}[$__range])) or vector(0)",
          "legendFormat": "求解",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(akkiabot_captcha_client_events_total{env=\"$env\",event=\"submitted\"}[$__range])) or vector(0)",
          "legendFormat": "提交",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(akkiabot_captcha_client_events_total{env=\"$env\",event=\"result\",outcome=\"passed\"}[$__range])) or vector(0)",
          "legendFormat": "通过",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "type": "timeseries",
      "title": "验证页面事件（按事件）",
      "description": "每个时间桶内验证页面上报的各类事件数，包括人机验证组件报错 / 过期、重试、关闭和无法显示组件（page_blocked）。",
      "id": 26,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (event) (increase(akkiabot_captcha_client_events_total{env=\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "页面看到的结果与被拒上报",
      "description": "result 事件按页面收到的结果分类（passed、各验证错误码、network_error、unexpected_response）；“拒收”是被事件接口拒绝的上报，按原因分类（initData 无效、超出单个验证的限额等）。",
      "id": 27,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (outcome) (increase(akkiabot_captcha_client_events_total{env=\"$env\",event=\"result\"}[$__rate_interval]))",
