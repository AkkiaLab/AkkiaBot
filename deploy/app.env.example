# Application config for deploy/compose.yaml (production). On the server: copy
# to `app.env` next to compose.yaml, fill in, `chmod 600 app.env`. Never commit
# the real file. Every key: docs/operations.md §配置项; schema:
# packages/core/src/akkiabot_core/config.py. Empty value = not set.
# DB_URL, REDIS_URL, SERVER_*, OBSERVABILITY_LOG_FORMAT and
# OBSERVABILITY_METRICS_* are set by compose.yaml and need not appear here.

# --- telegram (required: TELEGRAM_BOT_TOKEN, production bot from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
# webhook mode only: TELEGRAM_WEBHOOK_URL=https://bot-api.akkia.moe + a random secret
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TEST_ENVIRONMENT=false
TELEGRAM_MESSAGE_LOG_RETENTION_DAYS=30

# --- llm (antispam; OpenAI-compatible endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- llm tracing (optional; enabled only when both keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- whois (/ip)
WHOIS_IPINFO_TOKEN=

# --- captcha / Mini App
TURNSTILE_SECRET_KEY=
WEBAPP_URL=https://bot.akkia.moe
CORS_ALLOW_ORIGINS=https://bot.akkia.moe

# --- observability
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_SENTRY_DSN=
OBSERVABILITY_SENTRY_ENVIRONMENT=production
OBSERVABILITY_SENTRY_TRACES_SAMPLE_RATE=0.0
