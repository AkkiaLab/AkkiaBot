# Compose variables for the staging stack (bot-api-staging.akkia.moe). Copy to
# `.env` next to compose.yaml on the staging host; see docs/operations.md §预发布环境.
COMPOSE_PROJECT_NAME=akkiabot-staging
AKKIABOT_IMAGE=ghcr.io/akkialab/akkiabot
AKKIABOT_TAG=latest
AKKIABOT_HTTP_PORT=8001
# openssl rand -hex 32 (letters and digits only)
POSTGRES_PASSWORD=
# Token of the staging tunnel (bot-api-staging.akkia.moe -> http://app:8000)
CLOUDFLARED_TOKEN=
AKKIABOT_ENV=staging
# Grafana Cloud for Alloy: filled from grafana.env.tpl (docs/operations.md §8)
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_TOKEN=
