# Compose variables for deploy/compose.yaml. On the server: copy to `.env` next
# to compose.yaml, fill in, `chmod 600 .env`. Never commit the real file.
# Application config lives in `app.env` (deploy/app.env.example).

# Distinguishes stacks on one host (volumes, networks, containers):
# akkiabot for production, akkiabot-staging for staging.
COMPOSE_PROJECT_NAME=akkiabot

# Image: ghcr.io/akkialab/akkiabot:<git sha> (pin a sha in production; rollback
# = set the previous sha and `docker compose up -d --wait`).
AKKIABOT_IMAGE=ghcr.io/akkialab/akkiabot
AKKIABOT_TAG=latest

# Loopback port for host-side health checks (curl 127.0.0.1:<port>/readyz).
# Use a different port per stack on the same host (staging: 8001).
AKKIABOT_HTTP_PORT=8000

# PostgreSQL password, embedded in DB_URL: letters and digits only.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Token of this environment's Cloudflare tunnel (Zero Trust > Networks > Tunnels).
CLOUDFLARED_TOKEN=
