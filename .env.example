# Copy to `.env` and fill in values. Never commit `.env`.
# Schema: packages/core/src/akkiabot_core/config.py. Variable names are
# <GROUP>_<FIELD>; empty values count as "not set".

# --- telegram (TELEGRAM_BOT_TOKEN required)
TELEGRAM_BOT_TOKEN=
# polling (default) or webhook; webhook needs URL (public API base) + secret
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MESSAGE_LOG_RETENTION_DAYS=30
TELEGRAM_MESSAGE_LOG_CLEANUP_INTERVAL=3600
TELEGRAM_START_PAYLOAD_TTL=600
# true = Telegram test environment (/bot<token>/test/ endpoints, test BotFather tokens only)
TELEGRAM_TEST_ENVIRONMENT=false

# --- server (HTTP API: /healthz, /readyz, /telegram/webhook)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- db (required). PostgreSQL from deploy/compose.dev.yaml, or SQLite:
#   DB_URL=sqlite+aiosqlite:///./data/akkiabot.db
DB_URL=postgresql+asyncpg://akkiabot:akkiabot@127.0.0.1:5432/akkiabot
DB_ECHO=false

# --- redis (optional; in-process cache when empty)
REDIS_URL=redis://127.0.0.1:6379/0

# --- llm (OpenAI-compatible endpoint, used by antispam)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- turnstile (captcha)
TURNSTILE_SECRET_KEY=

# --- webapp (Mini App)
WEBAPP_URL=
WEBAPP_INIT_DATA_MAX_AGE=3600

# --- cors (comma-separated origins)
CORS_ALLOW_ORIGINS=

# --- observability
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_LOG_FORMAT=console
# Empty DSN = Sentry disabled, nothing is sent.
OBSERVABILITY_SENTRY_DSN=
OBSERVABILITY_SENTRY_ENVIRONMENT=development
OBSERVABILITY_SENTRY_TRACES_SAMPLE_RATE=0.0
OBSERVABILITY_METRICS_ENABLED=true
# Separate /metrics listener; keep it private (never route it through the tunnel)
OBSERVABILITY_METRICS_HOST=127.0.0.1
OBSERVABILITY_METRICS_PORT=9464

# --- frontend (apps/webapp, read by Vite at build time)
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- tests (optional): run DB / cache contract tests against real services
# AKKIABOT_TEST_DATABASE_URL=postgresql+asyncpg://akkiabot:akkiabot@127.0.0.1:5432/akkiabot
# AKKIABOT_TEST_REDIS_URL=redis://127.0.0.1:6379/15
