# Copy to `.env` and fill in values. Never commit `.env`.
# Schema: packages/core/src/akkiabot_core/config.py. Variable names are
# <GROUP>_<FIELD>; empty values count as "not set".

# --- telegram (TELEGRAM_BOT_TOKEN required)
TELEGRAM_BOT_TOKEN=
# polling (default) or webhook; webhook needs URL (public API base) + secret
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MESSAGE_LOG_RETENTION_DAYS=30
TELEGRAM_MESSAGE_LOG_CLEANUP_INTERVAL=3600
TELEGRAM_START_PAYLOAD_TTL=600
# true = Telegram test environment (/bot<token>/test/ endpoints, test BotFather tokens only)
TELEGRAM_TEST_ENVIRONMENT=false

# --- server (HTTP API: /healthz, /readyz, /telegram/webhook)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- db (required). PostgreSQL from deploy/compose.dev.yaml, or SQLite:
#   DB_URL=sqlite+aiosqlite:///./data/akkiabot.db
DB_URL=postgresql+asyncpg://akkiabot:akkiabot@127.0.0.1:5432/akkiabot
DB_ECHO=false

# --- redis (optional; in-process cache when empty)
REDIS_URL=redis://127.0.0.1:6379/0

# --- llm (OpenAI-compatible endpoint, used by antispam; no classification without key + model)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- antispam (group message checks and /spam reports)
# Reasoning models need 10-40s per call (BOT-11 baseline); timeouts fail open
ANTISPAM_TIMEOUT=45
# auto = JSON structured output, falling back to 0/1 answers; json_schema = no fallback; off = 0/1 only
ANTISPAM_STRUCTURED_OUTPUT=auto
# Optional UTF-8 file replacing the built-in base prompt, and its version label
ANTISPAM_PROMPT_FILE=
ANTISPAM_PROMPT_VERSION=
# Members with more than this many recorded messages are not checked
ANTISPAM_EXEMPT_MESSAGE_COUNT=3
ANTISPAM_PURGE_DELAY=5
ANTISPAM_NOTICE_TTL=60
# /spam reports by ordinary members: at most N per user within WINDOW seconds
ANTISPAM_REPORT_RATE_LIMIT=3
ANTISPAM_REPORT_RATE_WINDOW=300

# --- langfuse (LLM tracing; disabled unless both keys are set; empty host = Langfuse Cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- whois (/ip). Provider chain ipinfo -> ip-api; ipinfo is skipped without a token
WHOIS_IPINFO_TOKEN=
WHOIS_TIMEOUT=5
WHOIS_CACHE_TTL=3600
WHOIS_CACHE_SIZE=1024
# per-user limit: at most WHOIS_RATE_LIMIT lookups in WHOIS_RATE_WINDOW seconds
WHOIS_RATE_LIMIT=5
WHOIS_RATE_WINDOW=60

# --- turnstile (captcha). Without a secret key /api/v1/captcha/verify answers 503
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT=10

# --- webapp (Mini App), e.g. https://bot.akkia.moe; the captcha page is <url>/captcha
WEBAPP_URL=
WEBAPP_INIT_DATA_MAX_AGE=3600
# seconds a new member has to pass the join captcha (then stays muted)
WEBAPP_CAPTCHA_TIMEOUT=300

# --- cors (comma-separated origins; production: https://bot.akkia.moe)
CORS_ALLOW_ORIGINS=

# --- observability
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_LOG_FORMAT=console
# Empty DSN = Sentry disabled, nothing is sent.
OBSERVABILITY_SENTRY_DSN=
OBSERVABILITY_SENTRY_ENVIRONMENT=development
OBSERVABILITY_SENTRY_TRACES_SAMPLE_RATE=0.0
OBSERVABILITY_METRICS_ENABLED=true
# Separate /metrics listener; keep it private (never route it through the tunnel)
OBSERVABILITY_METRICS_HOST=127.0.0.1
OBSERVABILITY_METRICS_PORT=9464

# --- frontend (apps/webapp, read by Vite at build time)
VITE_API_BASE_URL=http://127.0.0.1:8000
# Turnstile site key (public). Empty: the dev server uses Cloudflare's always-pass test key
VITE_TURNSTILE_SITE_KEY=

# --- tests (optional): run DB / cache contract tests against real services
# AKKIABOT_TEST_DATABASE_URL=postgresql+asyncpg://akkiabot:akkiabot@127.0.0.1:5432/akkiabot
# AKKIABOT_TEST_REDIS_URL=redis://127.0.0.1:6379/15
