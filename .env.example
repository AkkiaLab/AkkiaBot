# Copy to `.env` and fill in values. Never commit `.env`.
# The full, typed configuration schema arrives with M1 (akkiabot_core.config);
# the variables below match deploy/compose.dev.yaml for local development.

# Database (PostgreSQL in compose.dev.yaml; SQLite also works for local runs)
DATABASE_URL=postgresql+asyncpg://akkiabot:akkiabot@127.0.0.1:5432/akkiabot

# Cache (optional; in-memory fallback when empty)
REDIS_URL=redis://127.0.0.1:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=

# Frontend (apps/webapp, read by Vite at build time)
VITE_API_BASE_URL=http://127.0.0.1:8000
