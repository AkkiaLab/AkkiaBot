{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "timezone": "Asia/Shanghai",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github-actions"
    },
    {
      "description": "Group non-major Python dev tooling",
      "matchManagers": ["pep621", "pre-commit"],
      "matchDepTypes": ["dependency-groups", "repository"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python dev tooling"
    },
    {
      "description": "Group non-major frontend dependencies",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend dependencies"
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
